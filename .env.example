# PowerDon Environment Configuration
# Copy this file to .env.local and fill in your values
# Vercel deployment: see docs/VERCEL_ENV.md

# ===========================================
# DATABASE (Required)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# First admin bootstrap (optional): when staff_roles is empty, this Auth email gets admin on first /admin/login
# BOOTSTRAP_ADMIN_EMAIL=you@company.com

# ===========================================
# AUTHENTICATION (Required for production)
# ===========================================
# API keys for internal services (generate with: openssl rand -hex 32)
TCP_PROXY_API_KEY=
ADMIN_API_KEY=
INTERNAL_API_KEY=

# ===========================================
# WSCHARGE / TCP PROXY (Required for hardware)
# ===========================================
# Protocol: WsCharge v5.8P over TCP (see docs/wscharge/)
WSCHARGE_ENABLED=true
TCP_PORT=8088
TCP_HOST=0.0.0.0
TCP_PROXY_URL=http://localhost:8089
API_BASE_URL=http://localhost:3000
API_AUTH_TOKEN=
STATION_PROXY_TOKEN=
TCP_PROXY_API_KEY=
WS_PORT=8089
WSCHARGE_COMMAND_TIMEOUT_MS=30000
WSCHARGE_HEARTBEAT_STALE_MS=120000
# TCP_PROXY_BACKOFF_MS=1000

# Public app URL (Stripe redirects, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true ONLY for offline UI dev without Supabase (never in production)
# NEXT_PUBLIC_USE_MOCK_DATA=true

# Allow hardware message route without token in development only
# ALLOW_INSECURE_HARDWARE_DEV=true

# ===========================================
# PAYMENTS (Required for rentals)
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ===========================================
# ALERTING (Optional)
# ===========================================
# SLACK_WEBHOOK_URL=
# ALERT_WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=

# ===========================================
# RATE LIMITING — distributed (recommended production)
# ===========================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# MONITORING (Optional)
# ===========================================
# METRICS_API_KEY=
# LOG_LEVEL=info
# SERVICE_NAME=powerdon-api
# APP_VERSION=1.0.0

# ===========================================
# CRON / MAINTENANCE (Production)
# ===========================================
# POST /api/cron/maintenance with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ===========================================
# EMAIL (Production transactional)
# ===========================================
# RESEND_API_KEY=
# EMAIL_FROM=PowerDon <noreply@yourdomain.com>

# ===========================================
# SECURITY (Optional)
# ===========================================
# Comma-separated list of allowed IPs for internal endpoints
# ALLOWED_IPS=
