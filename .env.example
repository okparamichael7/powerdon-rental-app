# PowerDon Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE (Required)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# AUTHENTICATION (Required for production)
# ===========================================
# API keys for internal services (generate with: openssl rand -hex 32)
TCP_PROXY_API_KEY=
ADMIN_API_KEY=
INTERNAL_API_KEY=

# ===========================================
# TCP PROXY (Required for hardware)
# ===========================================
TCP_PROXY_URL=http://localhost:8765
STATION_PROXY_TOKEN=

# Public app URL (Stripe redirects, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true ONLY for offline UI dev without Supabase (never in production)
# NEXT_PUBLIC_USE_MOCK_DATA=true

# Allow hardware message route without token in development only
# ALLOW_INSECURE_HARDWARE_DEV=true

# ===========================================
# PAYMENTS (Required for rentals)
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ===========================================
# ALERTING (Optional)
# ===========================================
# SLACK_WEBHOOK_URL=
# ALERT_WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=

# ===========================================
# MONITORING (Optional)
# ===========================================
# METRICS_API_KEY=
# LOG_LEVEL=info
# SERVICE_NAME=powerdon-api
# APP_VERSION=1.0.0

# ===========================================
# SECURITY (Optional)
# ===========================================
# Comma-separated list of allowed IPs for internal endpoints
# ALLOWED_IPS=
