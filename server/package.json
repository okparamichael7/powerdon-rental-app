{
  "name": "powerdon-tcp-proxy",
  "version": "1.0.0",
  "description": "TCP Proxy Server for WsCharge station connections",
  "main": "dist/tcp-proxy.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/tcp-proxy.js",
    "dev": "ts-node tcp-proxy.ts",
    "dev:simulator": "ts-node simulator.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:protocol": "node --import tsx --test tests/protocol.test.ts",
    "test:api": "node --import tsx --test tests/api.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0"
  }
}
